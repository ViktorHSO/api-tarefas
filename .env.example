# Usado pelo docker compose. Copie para .env e preencha.
# O arquivo .env não vai para o GitHub (está no .gitignore).

# Chave que assina os tokens JWT: pelo menos 32 caracteres aleatórios.
# Para gerar uma no PowerShell:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=

# Senhas do MySQL do container (opcional: sem elas são usados valores de desenvolvimento).
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
